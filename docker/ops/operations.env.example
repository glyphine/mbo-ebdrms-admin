COMPOSE_PROJECT_NAME=ebdrms
EBDRMS_BACKUP_DIR=/srv/ebdrms-backups
EBDRMS_BACKUP_RETENTION_DAYS=14
EBDRMS_BACKUP_CONFIG_DIR=/etc/ebdrms
EBDRMS_COMPOSE_ENV_FILE=/etc/ebdrms/compose.env
EBDRMS_API_ENV_FILE=/etc/ebdrms/api.env
EBDRMS_DB_ENV_FILE=/etc/ebdrms/db.env
EBDRMS_MAINTENANCE_ENV_FILE=/etc/ebdrms/maintenance.env
